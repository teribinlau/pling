{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pling",
  "version": "0.1.0",
  "identifier": "de.ilililab.pling",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "叮一下",
        "width": 1440,
        "height": 940,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: wss: http://localhost:* ws://localhost:*; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": { "language": ["zh-CN", "en-US"] },
      "nsis": { "languages": ["SimpChinese", "English"], "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2MDQ3OTM4MERCNzA1MzAKUldRd0JiY05PSGtFaGhrVE5md2xKZ0k0R1pSa1ZBdnZkdm96UU1jVGtsTXZ0MlJqZ0VoNGRkdDEK",
      "windows": { "installMode": "passive" }
    }
  }
}
