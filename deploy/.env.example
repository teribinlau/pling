# 叮一下 · 部署配置
# scripts/install.sh 第一次运行时复制成 .env，并自动填好网址、机构名和所有密钥。
# 改完 .env 后运行：docker compose up -d（或者再跑一次 scripts/install.sh）
# 值里有空格、$ 或中文时用单引号包起来：KEY='值'

# ============================================================================
# 必填（install.sh 会问）
# ============================================================================
# 网页地址：https://域名，结尾不要 /。大陆服务器的域名要先完成 ICP 备案
PLING_PUBLIC_URL=
# 机构名，显示在登录页（管理员之后可以在应用的「设置 → 机构」里改）
PLING_ORG_NAME=

# ============================================================================
# 密钥（install.sh 自动生成；不要改，改了已登录的人会掉线、已有数据可能打不开）
# ============================================================================
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
PG_META_CRYPTO_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
DASHBOARD_USERNAME=pling
DASHBOARD_PASSWORD=
# 数据库每分钟调用推送函数时带的口令
PLING_CRON_SECRET=
# 登录状态有效期（秒），到期自动续
JWT_EXPIRY=3600

# ============================================================================
# 邮箱验证码登录（建议配置：第一个管理员一般用它登录）
# 常见写法（用「授权码」，不是邮箱登录密码）：
#   QQ 邮箱：      SMTP_HOST=smtp.qq.com          SMTP_PORT=465
#   163 邮箱：     SMTP_HOST=smtp.163.com         SMTP_PORT=465
#   腾讯企业邮：   SMTP_HOST=smtp.exmail.qq.com   SMTP_PORT=465
#   阿里企业邮：   SMTP_HOST=smtp.qiye.aliyun.com SMTP_PORT=465
# 注意：很多云服务器默认封了 25 端口，用 465
# ============================================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 发件人地址（一般和 SMTP_USER 一样）
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=叮一下
# 全站每小时最多发多少封验证码邮件（也受邮箱服务商自己的限制）
RATE_LIMIT_EMAIL_SENT=100
# auto = 配了 SMTP 就显示邮箱登录；off = 不显示；on = 总是显示
PLING_EMAIL_LOGIN=auto

# ============================================================================
# 微信 / QQ（申请方法见 docs/申请指南.md；不填就不显示对应的登录方式）
# ============================================================================
# 微信开放平台「网站应用」：电脑上扫码登录
WECHAT_OPEN_APPID=
WECHAT_OPEN_SECRET=
# 微信服务号：微信里一键登录、提醒消息、扫码绑定
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
# 服务号后台「服务器配置」里自己填的 Token（3–32 位字母数字）
WECHAT_MP_TOKEN=
# 服务号后台选用的「模板消息」模板 ID，以及模板字段对应关系（字段名以模板详情为准）
WECHAT_MP_TEMPLATE_ID=
WECHAT_MP_TEMPLATE_FIELDS=title=thing1,time=time2,stage=phrase3
# QQ 互联「网站应用」
QQ_APPID=
QQ_APPKEY=

# ============================================================================
# HTTPS
# ============================================================================
# auto = 有证书就开 HTTPS；off = 只用 HTTP（仅限内网试用）
PLING_TLS=auto
# 自己的证书：放到 data/certs/ 下（容器里的路径如下）；用 Let's Encrypt 时不用管
PLING_SSL_CERT=/etc/pling/certs/fullchain.pem
PLING_SSL_KEY=/etc/pling/certs/privkey.pem
# Let's Encrypt 联系邮箱（scripts/cert.sh 用）
CERTBOT_EMAIL=
PLING_HTTP_PORT=80
PLING_HTTPS_PORT=443

# 可选组件，逗号分隔：certbot（自动续期证书）、studio（数据库管理后台，只在服务器本机 127.0.0.1:3000）
COMPOSE_PROFILES=
STUDIO_PORT=3000

# ============================================================================
# 其他
# ============================================================================
# 镜像地址前缀（国内拉 Docker Hub 慢时用），如 docker.1ms.run/ ；结尾要有 /
# 更推荐在 /etc/docker/daemon.json 里配 registry-mirrors（见部署指南）
PLING_REGISTRY=
# 云函数下载 npm 依赖的地址
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
# 数据目录（数据库、上传的文件、证书、安装包、备份），相对 deploy/ 目录
PLING_DATA_DIR=../data
# 网页文件目录（安装包里是 ../web）
PLING_WEB_DIR=../web
# 插进网页 <head> 的内容，比如 QQ 互联验证网站用的 meta 标签
PLING_HEAD_HTML=
# 应用一次最多读多少行数据（人多、提醒多的机构可以调大）
PGRST_DB_MAX_ROWS=50000
# 额外允许跨域调用云函数的来源（逗号分隔，一般不用填）
PLING_CORS_ORIGINS=
# 升级和下载电脑客户端用的发布地址（默认 GitHub；可以换成自己的镜像，路径格式 <地址>/v<版本>/<文件>）
PLING_RELEASE_BASE=https://github.com/teribinlau/pling/releases/download
